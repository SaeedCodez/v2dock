# Local shortcut for slow registry pulls: packages a binary cross-compiled on
# the host instead of building inside golang:1.26-alpine. Dockerfile stays the
# canonical build.
#
#   cd testsite
#   CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -trimpath -ldflags "-s -w" -o .bin/testsite .
#   docker build -f Dockerfile.prebuilt -t v2dock-testsite:local .
#
# Use GOARCH=amd64 on x86-64 hosts.
FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY .bin/testsite /usr/local/bin/netcheck
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/netcheck"]
