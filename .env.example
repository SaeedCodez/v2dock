# Copy to .env for plain `docker compose` (Coolify manages these itself).

# Pin a release instead of "latest" for reproducible deploys.
V2DOCK_VERSION=latest

# First admin password (min 12 characters). Leave empty to use the one-time
# setup token printed in the agent log instead.
V2DOCK_ADMIN_PASSWORD=

# Quota periods reset at midnight in this time zone.
TZ=Asia/Tehran

# Local port of the transparent proxy inside the host network namespace.
# Bound to 127.0.0.1 and firewalled; change only if 12701 is taken.
V2DOCK_TPROXY_PORT=12701
